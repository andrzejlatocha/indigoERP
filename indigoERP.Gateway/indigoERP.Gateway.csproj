<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\indigoERP.ServiceDefaults\indigoERP.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Jedno źródło prawdy dla statycznych plików dodatku Outlook — linkowane z indigoERP.Blazor, bez duplikowania. -->
    <Content Include="..\indigoERP.Blazor\wwwroot\addin\podpis\**" Link="wwwroot\addin\podpis\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
