@inject DialogService _dialogService
@inject IJSRuntime _jsRuntime

<AuthorizeView>
    <Authorized Context="auth">
        <div class="login-display d-flex align-items-center gap-3 me-3">
            <div class="theme-mode-toggle form-check form-switch mb-0">
                <input id="themeModeSwitch" class="form-check-input" type="checkbox" role="switch"
                       checked="@isDarkMode" @onchange="@OnThemeModeChanged" />
                <label class="form-check-label text-light" for="themeModeSwitch">@(isDarkMode ? "Ciemny" : "Jasny")</label>
            </div>
            <RadzenButton Text="@GetUserName(auth)" Icon="person" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Light"
                          Class="login-display__user btn btn-outline-light btn-sm" Click="@WyswietlUzytkownik" />
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private bool isDarkMode;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                isDarkMode = await _jsRuntime.InvokeAsync<bool>("indigoTheme.initialize");
                StateHasChanged();
            }
            catch (JSException)
            {
                isDarkMode = false;
            }
        }
    }

    public async Task WyswietlUzytkownik()
    {
        await _dialogService.OpenAsync<Uzytkownik>("Dane użytkownika",
            new Dictionary<string, object?>(),
            new DialogOptions { Width = "700px", Height = "512px", Resizable = false, Draggable = true });
    }

    private async Task OnThemeModeChanged(ChangeEventArgs args)
    {
        isDarkMode = args.Value is bool value && value;

        try
        {
            await _jsRuntime.InvokeVoidAsync("indigoTheme.setDarkMode", isDarkMode);
        }
        catch (JSException)
        {
            isDarkMode = false;
        }
    }

    private static string GetUserName(AuthenticationState auth)
    {
        var firstName = auth.User.FindFirst("usrImie")?.Value;
        var lastName = auth.User.FindFirst("usrNazwisko")?.Value;
        var fullName = $"{firstName} {lastName}".Trim();

        return string.IsNullOrWhiteSpace(fullName) ? auth.User.FindFirst("usrNazwa")?.Value ?? auth.User.Identity?.Name ?? "Użytkownik" : fullName;
    }
}
