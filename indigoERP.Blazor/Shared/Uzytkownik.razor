@inject AuthenticationStateProvider _authenticationStateProvider

<div class="row w-100 mt-1 h3">
    <div class="col-12 text-center">
        <img class="rounded-circle" src="@String.Format(@"{0}", usrZdjecie)" alt="Użytkownik" aria-label="Użytkownik" height="80" width="80" />
    </div>
</div>

<div class="row w-100 mt-1 h3">
    <div class="col-12 text-center">
        <div class="d-inline-block">
            @usrImie
        </div>
        <div class="d-inline-block ml-1">
            @usrNazwisko
        </div>
        <div class="d-inline-block ml-1">
            ( @usrLogin )
        </div>
    </div>
</div>

<div class="row w-100 mt-1">
    <div class="col-12 text-center">
        <a href="@String.Format(@"mailto:{0}", usrEmail)">
            @usrEmail
        </a>
    </div>
</div>

<div class="row w-100 mt-4 h4">
    <div class="col-12 text-center">
        <div class="d-inline-block">
            @wdzKod
        </div>
        <div class="d-inline-block ml-1">
            @wdzNazwa
        </div>
        <div class="d-inline-block ml-1">
            ( @wdzSymbol )
        </div>
    </div>
</div>

<div class="row w-100 mt-1">
    <div class="col-12 text-center">
        <div class="d-inline-block">
            @stnKod
        </div>
        <div class="d-inline-block ml-1">
            @stnNazwa
        </div>
    </div>
</div>

@code {
    private int usrID;
    private string usrImie = string.Empty;
    private string usrNazwisko = string.Empty;
    private string wdzKod = string.Empty;
    private string wdzSymbol = string.Empty;
    private string wdzNazwa = string.Empty;
    private string stnKod = string.Empty;
    private string stnNazwa = string.Empty;
    private string usrLogin = string.Empty;
    private string usrEmail = string.Empty;
    private string usrZdjecie = "images/empty.png";

    protected async override Task OnInitializedAsync()
    {
        var authState = await _authenticationStateProvider.GetAuthenticationStateAsync();
        var uzytkownik = authState.User;

        usrID = int.TryParse(GetClaimValue(uzytkownik, "usrID"), out var userId) ? userId : 0;
        usrImie = GetClaimValue(uzytkownik, "usrImie");
        usrNazwisko = GetClaimValue(uzytkownik, "usrNazwisko");
        usrLogin = GetClaimValue(uzytkownik, "usrLogin");

        wdzKod = GetClaimValue(uzytkownik, "wdzKod");
        wdzSymbol = GetClaimValue(uzytkownik, "wdzSymbol");
        wdzNazwa = GetClaimValue(uzytkownik, "wdzNazwa");

        stnKod = GetClaimValue(uzytkownik, "stnKod");
        stnNazwa = GetClaimValue(uzytkownik, "stnNazwa");

        usrEmail = GetClaimValue(uzytkownik, "usrEmail");
        usrZdjecie = GetClaimValue(uzytkownik, "usrZdjecie", "images/empty.png");
    }

    private static string GetClaimValue(System.Security.Claims.ClaimsPrincipal user, string claimType, string defaultValue = "")
    {
        return user.FindFirst(claimType)?.Value ?? defaultValue;
    }
}
