@using indigoERP.Domain.ViewModels._Administracja
@using indigoERP.Service.Interfaces._Administrator

@inject ISerwerService _serwerService
@inject IConfiguration _configuration

<footer class="footer text-muted mt-auto">
    <div class="container-fluid w-100">
        <div class="row">
            <div class="col-12 text-light">
                <div class="d-inline-block">
                    Copyright&copy; <a href="@BaseUrl" class="text-light" aria-label="Przejdź do indigoERP">Huta Częstochowa
                    <img src="images/logo/Logo16.png" /></a> 1993 - @DateTime.Now.Year All Rights Reserved
                </div>
                <div class="d-inline-block ms-5">
                    <img src="images/footer/ico_phone.png" width="20" /> <span class="ms-2">+48 34 323 8000</span>
                </div>
                <div class="d-inline-block ms-5">
                    <a href="mailto:itsupport@huta-czestochowa.pl">
                        <img src="images/footer/ico_email.png" width="20" /><span class="ms-2">itsupport@huta-czestochowa.pl</span>
                    </a>
                </div>
                @if (serwer != null)
                {
                    <div class="d-inline-block ms-5 footer-serwer-panel">
                        <span>Wersja API: @serwer.WersjaApi</span>
                        <span class="ms-3">Serwer: @serwer.SerwerSql</span>
                        <span class="ms-3">Baza: @serwer.BazaDanych</span>
                    </div>
                }
            </div>
        </div>
    </div>
</footer>

@code {
    private SerwerInfoViewModel? serwer;

    private string BaseUrl => _configuration["appSettings:BaseUrl"] ?? "./";

    protected override async Task OnInitializedAsync()
    {
        serwer = await _serwerService.GetInfo();
    }
}
