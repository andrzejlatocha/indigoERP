@using indigoERP.Domain.Common
@using indigoERP.Domain.Models._Wspolne
@using indigoERP.Service.Interfaces._Wspolne

@inject IWiadomoscPracownikService _wiadomoscPracownikService
@inject DialogService _dialogService
@inject NotificationService _notificationService

<div class="p-2">
    <RadzenFormField Text="Temat" Style="width:100%">
        <RadzenTextBox @bind-Value="@temat" Style="width:100%" />
    </RadzenFormField>
    <RadzenFormField Text="Treść" Style="width:100%">
        <RadzenHtmlEditor @bind-Value="@tresc" Style="height:280px" />
    </RadzenFormField>
    @if (wlasne)
    {
        <RadzenFormField Text="Adresy e-mail" Style="width:100%">
            <RadzenDropDown TValue="IEnumerable<string>" Value="@adresy" ValueChanged="@OnAdresyZmienione"
                            Multiple="true" AllowCustomValues="true" AllowClear="true" Data="@(new List<string>())" Style="width:100%" />
        </RadzenFormField>
        @if (adresy.Count > 0 && AdresyEmail.Waliduj(adresy).Blad is { } blad)
        {
            <div class="text-danger small">@blad</div>
        }
    }
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Class="mt-2">
        <RadzenButton Text="@(zapisywanie ? "Zapisywanie..." : "Zapisz")" Icon="save" ButtonStyle="ButtonStyle.Primary"
                      Click="@ZapiszAsync" Disabled="@(zapisywanie || string.IsNullOrWhiteSpace(temat) || (wlasne && AdresyEmail.Waliduj(adresy).Blad != null))" />
        <RadzenButton Text="Anuluj" Icon="cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => _dialogService.CloseSide(false))" Disabled="@zapisywanie" />
    </RadzenStack>
</div>

@code {
    [Parameter]
    public int WiadomoscID { get; set; }

    [Parameter]
    public string? Temat { get; set; }

    [Parameter]
    public string? Tresc { get; set; }

    /// <summary>Własna lista adresów wiadomości (zakres z wzaWlasne); brak = wiadomość z zakresem pracowników.</summary>
    [Parameter]
    public List<string>? Adresy { get; set; }

    private string temat = string.Empty;
    private string? tresc;
    private bool zapisywanie;
    private bool wlasne;
    private List<string> adresy = new();

    protected override void OnInitialized()
    {
        temat = Temat ?? string.Empty;
        tresc = Tresc;
        wlasne = Adresy is { Count: > 0 };
        adresy = Adresy?.ToList() ?? new List<string>();
    }

    private void OnAdresyZmienione(IEnumerable<string>? wartosci)
    {
        adresy = wartosci?.ToList() ?? new List<string>();
    }

    private async Task ZapiszAsync()
    {
        zapisywanie = true;

        try
        {
            var model = new WiadomoscPoprawaModel
            {
                wiaTemat = temat,
                wiaTresc = tresc,
                adresy = wlasne ? AdresyEmail.Waliduj(adresy).Adresy : null
            };
            var wynik = await _wiadomoscPracownikService.PoprawRobocza(WiadomoscID, model);

            if (wynik.Code < 200 || wynik.Code >= 300)
            {
                _notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Błąd",
                    Detail = wynik.Message ?? "Nie udało się zapisać zmian.",
                    Duration = 8000
                });
                return;
            }

            _dialogService.CloseSide(true);
        }
        finally
        {
            zapisywanie = false;
        }
    }
}
