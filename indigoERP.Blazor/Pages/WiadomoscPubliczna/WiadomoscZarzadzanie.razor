@using indigoERP.Domain.Dtos._Wspolne
@using indigoERP.Domain.ViewModels._Wspolne
@using indigoERP.Service.Interfaces._Wspolne
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Primitives

@inject DialogService _dialogService
@inject NotificationService _notificationService
@inject NavigationManager _navigationManager
@inject IJSRuntime _js
@inject IWiadomoscPracownikService _wiadomoscPracownikService
@inject IConfiguration _configuration

@* Osadzone w publicznej stronie Razor (/wiadomosc) tylko dla ról Gazeta / Administrator. Okna wysyłki otwierają się na środku. *@
<RadzenDialog />
<RadzenNotification />

<RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
    <RadzenButton Text="Nowa wiadomość" Icon="add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Click="@OtworzNowy" />
</RadzenStack>

@if (zaplanowane.Count > 0)
{
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" Class="w-100 mt-2">
        <span class="text-muted small">Zaplanowane:</span>
        @foreach (var cykl in zaplanowane)
        {
            <RadzenButton Text="@OpisCyklu(cykl)" Icon="cancel" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                          Variant="Variant.Outlined" Click="@(() => AnulujCykl(cykl))" />
        }
    </RadzenStack>
}

@if (ladowanie)
{
    <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" Style="height:4px; width:200px" />
}
else if (robocze is { Count: > 0 })
{
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap" Class="w-100 mt-2">
        <span class="text-muted small">Robocze:</span>
        @foreach (var wiadomosc in robocze)
        {
            <RadzenButton Text="@($"Wyślij: {wiadomosc.wiaTemat}")" Icon="send" Size="ButtonSize.Small"
                          ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Click="@(() => OtworzWysylke(wiadomosc))" />
        }
    </RadzenStack>
}

@code {
    private List<WiadomoscDto>? robocze;
    private bool ladowanie = true;
    private List<WiadomoscHarmonogramViewModel> zaplanowane = new();

    private int AppID => _configuration.GetValue<int?>("appSettings:AppID") ?? 900;

    protected override async Task OnInitializedAsync()
    {
        await OdswiezRobocze();
        await OdswiezZaplanowane();
    }

    // Po przeładowaniu strony (patrz PrzeladujZKomunikatem) pokazujemy komunikat z adresu i usuwamy go z adresu, żeby nie wracał przy F5.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var query = QueryHelpers.ParseQuery(new Uri(_navigationManager.Uri).Query);

        if (!query.TryGetValue(WiadomoscWynik.ParametrTytul, out var tytul) || StringValues.IsNullOrEmpty(tytul))
        {
            return;
        }

        query.TryGetValue(WiadomoscWynik.ParametrTresc, out var tresc);
        var severity = query.TryGetValue(WiadomoscWynik.ParametrSeverity, out var kodSeverity)
            && int.TryParse(kodSeverity, out var wartosc) && Enum.IsDefined(typeof(NotificationSeverity), wartosc)
                ? (NotificationSeverity)wartosc
                : NotificationSeverity.Success;

        _notificationService.Notify(new NotificationMessage
        {
            Severity = severity,
            Summary = tytul.ToString(),
            Detail = tresc.ToString(),
            Duration = 8000
        });

        try
        {
            await _js.InvokeVoidAsync("wiadomoscPubliczna.usunKomunikat");
        }
        catch (JSException)
        {
            // Brak JS: komunikat może wrócić po odświeżeniu, nie blokuje to pracy z listą.
        }
    }

    private async Task OdswiezRobocze()
    {
        try
        {
            robocze = (await _wiadomoscPracownikService.SelectRobocze(AppID)).ToList();
        }
        finally
        {
            ladowanie = false;
        }
    }

    private async Task OdswiezZaplanowane()
    {
        zaplanowane = (await _wiadomoscPracownikService.SelectHarmonogram(AppID)).ToList();
    }

    private async Task AnulujCykl(WiadomoscHarmonogramViewModel cykl)
    {
        var wynik = await _wiadomoscPracownikService.AnulujHarmonogram(cykl.wiaID);

        if (wynik.Code < 200 || wynik.Code >= 300)
        {
            _notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Błąd",
                Detail = wynik.Message ?? "Nie udało się anulować harmonogramu.",
                Duration = 8000
            });
            return;
        }

        _notificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Success,
            Summary = "Anulowano",
            Detail = $"Harmonogram „{cykl.wiaTemat}” został anulowany.",
            Duration = 8000
        });

        await OdswiezZaplanowane();
    }

    private static string OpisCyklu(WiadomoscHarmonogramViewModel cykl)
    {
        var rodzaj = cykl.wiaKodHarmonogram switch
        {
            "D" => "codziennie",
            "T" => "tygodniowo",
            "M" => "miesięcznie",
            _ => "jednorazowo",
        };
        var nastepna = cykl.wiaDataNastepnejWysylki?.ToString("dd.MM.yyyy HH:mm") ?? "-";

        return $"Anuluj: {cykl.wiaTemat} ({rodzaj}, następna: {nastepna})";
    }

    private async Task OtworzNowy()
    {
        var wynik = await _dialogService.OpenSideAsync<WiadomoscWysylkaOkno>(
            "Nowa wiadomość",
            new Dictionary<string, object?>(),
            GetSideOptions());

        PrzeladujZKomunikatem(wynik);
    }

    private async Task OtworzWysylke(WiadomoscDto wiadomosc)
    {
        var wynik = await _dialogService.OpenSideAsync<WiadomoscWysylkaOkno>(
            $"Wysyłka: {wiadomosc.wiaTemat}",
            new Dictionary<string, object?> { ["WiadomoscID"] = wiadomosc.wiaID, ["Tytul"] = wiadomosc.wiaTemat },
            GetSideOptions());

        PrzeladujZKomunikatem(wynik);
    }

    // Sukces zamyka okno boczne i przeładowuje stronę, żeby odświeżyć listy po stronie serwera.
    // Komunikat jedzie w adresie i pokazuje się po ponownym renderowaniu (OnAfterRenderAsync).
    private void PrzeladujZKomunikatem(object? wynik)
    {
        if (wynik is not WiadomoscWynik glos)
        {
            return;
        }

        var bazowy = new Uri(_navigationManager.Uri).GetLeftPart(UriPartial.Path);
        var adres = QueryHelpers.AddQueryString(bazowy, new Dictionary<string, string?>
        {
            [WiadomoscWynik.ParametrSeverity] = ((int)glos.Severity).ToString(),
            [WiadomoscWynik.ParametrTytul] = glos.Tytul,
            [WiadomoscWynik.ParametrTresc] = glos.Tresc
        });

        _navigationManager.NavigateTo(adres, forceLoad: true);
    }

    // Okno boczne z prawej, szerokość 1000px; zawartość przewija się w całości, nic nie jest ucinane.
    private static SideDialogOptions GetSideOptions() => new()
    {
        Position = DialogPosition.Right,
        Width = "1000px",
        CloseDialogOnOverlayClick = false,
        ShowTitle = true,
        ShowClose = true,
        CssClass = "glos-okno-dialog"
    };
}
