@using indigoERP.Domain.Dtos._Wspolne
@using indigoERP.Service.Interfaces._Wspolne

@inject IWiadomoscPracownikService _wiadomoscPracownikService
@inject IConfiguration _configuration
@inject DialogService _dialogService
@inject NotificationService _notificationService

@* Panel zarządzania na publicznej stronie (/wiadomosc) tylko dla ról Gazeta / Administrator.
   Jedna linia: po lewej Nowa wiadomość i akcje dla wybranego rekordu, po prawej filtr statusu i rok. *@

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center"
             Wrap="FlexWrap.Wrap" Gap="0.5rem" Class="w-100">
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
        <WiadomoscZarzadzanie ShowListy="false" />
        <RadzenButton Text="Szczegóły" Icon="visibility" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Variant="Variant.Outlined"
                      Disabled="@(wybrana == null)" Click="@OtworzSzczegolyAsync" />
        @if (wybrana != null && MozeBycPoprawiona(wybrana))
        {
            <RadzenButton Text="Popraw" Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Variant="Variant.Outlined"
                          Click="@(() => OtworzPoprawkeAsync(wybrana!))" />
            <RadzenButton Text="Usuń" Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined"
                          Click="@(() => UsunAsync(wybrana!))" />
        }
        @if (wybrana != null && MozeBycAnulowana(wybrana))
        {
            <RadzenButton Text="Anuluj" Icon="cancel" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Outlined"
                          Click="@(() => AnulujAsync(wybrana!))" />
        }
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
        <RadzenDropDown TValue="int" Data="@Lata" @bind-Value="rok" Style="width: 220px;" />
        <RadzenDropDown TValue="int" Data="@filtry" TextProperty="Tekst" ValueProperty="Wartosc" @bind-Value="filtrStatusu" Style="width: 560px;" />
    </RadzenStack>
</RadzenStack>

<WiadomoscZarzadzanie ShowNowa="false" />

@if (ladowanie)
{
    <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" Style="height:4px; margin-top:1rem" />
}
else
{
    <ListaWiadomosci Lista="@WiadomosciRoku" Wybrana="@wybrana" WybranaChanged="@(w => wybrana = w)" />
}

@code {
    // Rekordy sprzed tej daty nie są pokazywane (ustalenie użytkownika).
    private static readonly DateTime DataOd = new(2026, 10, 1);

    // Filtry statusu: 0 = aktualne (czeka na wysyłkę „2” i w trakcie „3”), 1 = wysłane („4”), 2 = wszystkie.
    private sealed record FiltrStatusu(string Tekst, int Wartosc);

    private static readonly List<FiltrStatusu> filtry =
    [
        new("aktualne: nowe i w trakcie wysyłania", 0),
        new("wysłane", 1),
        new("wszystkie", 2)
    ];

    private List<WiadomoscPodsumowanieDto> wszystkie = new();
    private bool ladowanie = true;
    private WiadomoscPodsumowanieDto? wybrana;

    private int rok = DateTime.Now.Year;
    private int filtrStatusu = 0;

    private int AppID => _configuration.GetValue<int?>("appSettings:AppID") ?? 900;

    private IEnumerable<WiadomoscPodsumowanieDto> Widoczne => wszystkie.Where(w => w.wiaData >= DataOd);

    // Bieżący rok zawsze na liście, nawet bez wiadomości.
    private List<int> Lata => Widoczne
        .Where(w => w.wiaData != null)
        .Select(w => w.wiaData!.Value.Year)
        .Append(DateTime.Now.Year)
        .Distinct()
        .OrderByDescending(y => y)
        .ToList();

    private IEnumerable<WiadomoscPodsumowanieDto> WiadomosciRoku => Widoczne
        .Where(w => w.wiaData?.Year == rok)
        .Where(PasujeDoStatusu)
        .OrderByDescending(w => w.wiaData);

    private bool PasujeDoStatusu(WiadomoscPodsumowanieDto wiadomosc) => filtrStatusu switch
    {
        0 => wiadomosc.wiaStatus is "2" or "3",
        1 => wiadomosc.wiaStatus == "4",
        _ => true
    };

    // Poprawka i usunięcie tylko przed rozpoczęciem wysyłki (status „2”); anulowanie także w trakcie (status „3”).
    private static bool MozeBycPoprawiona(WiadomoscPodsumowanieDto wiadomosc) => wiadomosc.wiaStatus == "2";

    private static bool MozeBycAnulowana(WiadomoscPodsumowanieDto wiadomosc) => wiadomosc.wiaStatus is "2" or "3";

    protected override async Task OnInitializedAsync()
    {
        await OdswiezAsync();
    }

    private async Task OdswiezAsync()
    {
        ladowanie = true;
        wybrana = null;

        try
        {
            wszystkie = (await _wiadomoscPracownikService.SelectPodsumowanie(AppID)).ToList();
        }
        finally
        {
            ladowanie = false;
        }
    }

    private async Task OtworzSzczegolyAsync()
    {
        if (wybrana is null)
        {
            return;
        }

        await _dialogService.OpenSideAsync<WiadomoscDetail>(wybrana.wiaTemat ?? "Wiadomość",
            new Dictionary<string, object?> { ["Model"] = wybrana },
            new SideDialogOptions { Position = DialogPosition.Right, Width = "760px", CloseDialogOnOverlayClick = false, ShowTitle = true, ShowClose = true });
    }

    // Poprawka tylko dla wiadomości, której wysyłka się nie rozpoczęła (status „2”); API sprawdza to samo.
    private async Task OtworzPoprawkeAsync(WiadomoscPodsumowanieDto wiadomosc)
    {
        var wynik = await _dialogService.OpenSideAsync<WiadomoscPoprawaOkno>("Popraw wiadomość",
            new Dictionary<string, object?>
            {
                ["WiadomoscID"] = wiadomosc.wiaID,
                ["Temat"] = wiadomosc.wiaTemat,
                ["Tresc"] = wiadomosc.wiaTresc,
                // Wiadomość z własną listą adresów: tagbox w oknie poprawki; pozostałe bez zmian.
                ["Adresy"] = wiadomosc.wiaAdresy.Count > 0 ? wiadomosc.wiaAdresy : null
            },
            new SideDialogOptions { Position = DialogPosition.Right, Width = "1000px", CloseDialogOnOverlayClick = false, ShowTitle = true, ShowClose = true });

        if (wynik is true)
        {
            _notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Zapisano", Detail = "Zmiany zostały zapisane.", Duration = 8000 });
            await OdswiezAsync();
        }
    }

    private async Task UsunAsync(WiadomoscPodsumowanieDto wiadomosc)
    {
        var potwierdzenie = await _dialogService.Confirm($"Usunąć wiadomość „{wiadomosc.wiaTemat}”? Tej operacji nie można cofnąć.", "Usuń wiadomość",
            new ConfirmOptions { OkButtonText = "Usuń", CancelButtonText = "Nie" });

        if (potwierdzenie != true)
        {
            return;
        }

        var wynik = await _wiadomoscPracownikService.UsunWiadomosc(wiadomosc.wiaID);

        if (wynik.Code < 200 || wynik.Code >= 300)
        {
            _notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Błąd", Detail = wynik.Message ?? "Nie udało się usunąć wiadomości.", Duration = 8000 });
            return;
        }

        _notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Usunięto", Detail = $"Wiadomość „{wiadomosc.wiaTemat}” została usunięta.", Duration = 8000 });
        await OdswiezAsync();
    }

    // Anulowanie zatrzymuje wysyłkę (status „2” lub „3”); po anulowaniu wiadomość ma status „6”.
    private async Task AnulujAsync(WiadomoscPodsumowanieDto wiadomosc)
    {
        var wynik = await _wiadomoscPracownikService.AnulujHarmonogram(wiadomosc.wiaID);

        if (wynik.Code < 200 || wynik.Code >= 300)
        {
            _notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Błąd", Detail = wynik.Message ?? "Nie udało się anulować wysyłki.", Duration = 8000 });
            return;
        }

        _notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Anulowano", Detail = $"Wysyłka „{wiadomosc.wiaTemat}” została zatrzymana.", Duration = 8000 });
        await OdswiezAsync();
    }
}
