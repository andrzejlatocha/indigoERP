@page "/"

@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JSRuntime
@inject IAplikacjaService _aplikacjaService

@using Microsoft.JSInterop;
@using indigoERP.Domain.ViewModels;
@using indigoERP.Service.Interfaces._Administrator;

<PageTitle>indigoERP</PageTitle>

<div class="row main-image">
    <div class="col-3">
        <div class="w-100">
            <div class="navigation">
                @if (data == null)
                {
                    <div class="d-flex justify-content-center align-items-center" style="height: 100%;">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var item in data)
                    {
                        <a href="@item.appLink" class="box">
                            <div class="d-inline-block">
                                <div class="image">
                                    <img src="@item.appIkona" alt="Ikona" />
                                </div>
                            </div>
                            <div class="d-inline-block">
                                <div class="title">
                                    @item.appNazwa
                                </div>
                                <div class="text">
                                    @item.appOpis
                                </div>
                            </div>
                        </a>
                    }
                }
            </div>
        </div>
    </div>
    <div class="col-9">
        <div class="w-100 mt-3">
            <RadzenAlert ShowIcon="false" AlertStyle="AlertStyle.Danger" AllowClose="false" Shade="Shade.Light" Size="AlertSize.Small"
                            Variant="Variant.Filled" Visible=@browserWarrningVisible class="w-100">
                <i class="fa-solid fa-light-emergency-on fa-lg me-3"></i>
                Zalecamy używanie przeglądarki Microsoft Edge w celu wykorzastania wszystkich możliwości Microsoft 365!
            </RadzenAlert>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="alert alert-danger w-100 h5" role="alert">
                    <i class="fa-solid fa-info fa-lg me-2"></i>
                    Dostęp do starszych wersji aplikacji przez stronę <a href="https://intranet.hcz.com.pl" target="_blank">INTRANET</a>.
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="alert alert-success w-100 h5" role="alert">
                    <i class="fa-solid fa-envelopes fa-lg me-2"></i>
                    Masz problem, pytanie, uwagi czy nowy pomysł <a href="/support">napisz wiadomość do Działu IT</a>.
                </div>                
            </div>
        </div>
        <div class="row">
            <div class="col-12">

            </div>
        </div>
        <div class="row">
            <div class="col-4">
                <div class="area-main">
                    <a href="https://outlook.office.com/mail/">
                        <div class="service">
                            <div class="logo">
                                <img src="images/outlook.png" />
                            </div>
                            <h4>Poczta</h4>
                            <p>
                                Zarządzaj swoją pocztą przy pomocy Microsoft Outlook w przeglądarce.
                            </p>
                        </div>
                    </a>
                    <div class="shadow1">
                    </div>
                    <div class=shadow2>
                    </div>
                </div>
            </div>
            <div class="col-4">
                <div class="area-main">
                    <a href="https://outlook.office.com/calendar/">
                        <div class="service">
                            <div class="logo">
                                <img src="images/calendar.png" />
                            </div>
                            <h4>Kalendarz</h4>
                            <p>
                                Organizuj swój czas kalendarz twój i twojego teamu zawsze dostępny.
                            </p>
                        </div>
                    </a>
                    <div class="shadow1">
                    </div>
                    <div class=shadow2>
                    </div>
                </div>
            </div>
            <div class="col-4">
                <div class="area-main">
                    <a href="https://hutaczestochowa-my.sharepoint.com/">
                        <div class="service">
                            <div class="logo">
                                <img src="images/onedrive.png" />
                            </div>
                            <h4>OneDrive</h4>
                            <p>
                                Bądź bezpieczny trzymaj wszystkie dokumenty w chmurze gdzie są zawsze dostępne.
                            </p>
                        </div>
                    </a>
                    <div class="shadow1">
                    </div>
                    <div class=shadow2>
                    </div>
                </div>
            </div>
            <div class="col-4">

            </div>
            <div class="col-4">

            </div>
            <div class="col-4">

            </div>
        </div>
    </div>
</div>

@code{
    IEnumerable<AplikacjaViewModel> data ;
    bool browserWarrningVisible;

    protected override async Task OnInitializedAsync()
    {

    }

    protected override async Task OnParametersSetAsync()
    {
        var result = await _aplikacjaService.Select("2");

        data = result.Where(w => w.appWyswietl == true);

        //await VerifyBrowser();
    }

    async Task VerifyBrowser()
    {
        string verifyInfo = await JSRuntime.InvokeAsync<string>(identifier: "identifyBrowser");

        browserWarrningVisible = verifyInfo == "yes";
    }
}
