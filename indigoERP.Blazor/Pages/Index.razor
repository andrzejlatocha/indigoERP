@code{
    bool browserWarrningVisible;

    protected override async Task OnParametersSetAsync()
    {
        VerifyBrowser();
    }

    async Task VerifyBrowser()
    {
        string verifyInfo = await JSRuntime.InvokeAsync<string>(identifier: "identifyBrowser");

        browserWarrningVisible = verifyInfo == "yes";
    }
}
