@page "/admistrator/grupa"
@attribute [Authorize(Roles = "PL-SCX-APP-indigoER-Administrator")]

@using indigoERP.Domain.Entities._Administrator
@using indigoERP.Service.Interfaces._Administrator

@inject IGrupaService _grupaService
@inject NavigationManager _navigationManager
@inject DialogService _dialogService
@inject TooltipService _tooltipService

<div class="row w-100 ms-1 pt-2">
    <div class="col-8">
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.Normal" AlignItems="AlignItems.Normal">
            <RadzenMenu>
                <RadzenMenuItem Text="Dodaj" Icon="@("<i class=\"fa fa-plus-circle\"></i>")" Click="OnBuild" MouseEnter="@(args => ShowTooltip(args) )">
                </RadzenMenuItem>
                <RadzenMenuItem Text="Popraw" Icon="@("<i class=\"fa fa-edit\"></i>")" Click="OnBuild">
                </RadzenMenuItem>
                <RadzenMenuItem Text="Szczegóły" Icon="@("<i class=\"fa fa-info\"></i>")" Click="OnDetail">
                </RadzenMenuItem>
                <RadzenMenuItem Text="Anuluj" Icon="@("<i class=\"fa fa-ban\"></i>")" Click="OnBuild">
                </RadzenMenuItem>
                <RadzenMenuItem Text="Usuń" Icon="@("<i class=\"fa fa-trash\"></i>")" Click="OnBuild">
                </RadzenMenuItem>
            </RadzenMenu>
            <RadzenMenu>
                <RadzenMenuItem Text="Dodaj grupę" Icon="@("<i class=\"fa fa-user-group\"></i>")" Click="OnBuild">
                </RadzenMenuItem>
                <RadzenMenuItem Text="Dodaj rolę" Icon="@("<i class=\"fa fa-object-group\"></i>")" Click="OnBuild">
                </RadzenMenuItem>
            </RadzenMenu>
        </RadzenStack>
    </div>
    <div class="col-4">
        <div class="float-end">
            <RadzenSelectBar @bind-Value=@valStatus TValue="int" Change="OnStatusChange">
                <Items>
                    <RadzenSelectBarItem Text="Aktywne" Value="0" />
                    <RadzenSelectBarItem Text="Anulowane" Value="1" />
                    <RadzenSelectBarItem Text="Wszystkie" Value="2" />
                </Items>
            </RadzenSelectBar>
        </div>
    </div>
</div>
<div class="row w-100 mt-2 ms-1 me-2">
    <div class="col-12">
        @if (data == null)
        {
            <Load />
        }
        else
        {
            <RadzenDataGrid @ref="grid" Data="@data" AllowAlternatingRows="false" FilterMode="FilterMode.Simple"
                            AllowSorting="true" PageSize="24" AllowPaging="true" TItem="Grupa" Density="Density.Compact"
                            SelectionMode="Radzen.DataGridSelectionMode.Single" @bind-Value=@selectedItem
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            LogicalFilterOperator="LogicalFilterOperator.And">
                <Columns>
                    <RadzenDataGridColumn TItem="Grupa" Property="groID" Title="Symbol" Width="40px" Visible="false" />
                    <RadzenDataGridColumn TItem="Grupa" Property="groStatus" Title="S" Width="40px">
                        <Template Context="data">
                            <RadzenImage Path="@String.Format(@"Images/status/{0}.png", data.groStatus)" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Grupa" Property="groNazwa" Title="Nazwa" />
                    <RadzenDataGridColumn TItem="Grupa" Property="groOpis" Title="Opis" />
                    <RadzenDataGridColumn TItem="Grupa" Property="groDataWaznosc" Title="Ważne do" Width="120px" FormatString="{0:d}" />
                    <RadzenDataGridColumn TItem="Grupa" Property="groAdmistrator" Title="A" Width="40px">
                        <Template Context="data">
                            <RadzenCheckBox Value="@data.groAdministrator">
                            </RadzenCheckBox>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Grupa" Property="groBlokada" Title="B" Width="40px">
                        <Template Context="data">
                            <RadzenCheckBox Value="@data.groBlokada">
                            </RadzenCheckBox>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Grupa" Property="groEdycja" Title="E" Width="40px">
                        <Template Context="data">
                            <RadzenCheckBox Value="@data.groEdycja">
                            </RadzenCheckBox>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Grupa" Property="groSynchronizacjaAD" Title="S" Width="40px">
                        <Template Context="data">
@*                             <RadzenCheckBox Value="@data.groSynchronizacjaAD">
                            </RadzenCheckBox> *@
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid> 
        }
    </div>
</div>

@code {
    public string? groStatus { get; set; }
    RadzenDataGrid<Grupa> grid;
    IList<Grupa> selectedItem;
    private int valStatus;
    private IEnumerable<Grupa>? data;
    private List<string> groParam = new List<string>() { "2", "1", "*" };

    protected override async Task OnParametersSetAsync()
    {
        groStatus = "2";
        valStatus = groParam.IndexOf(groStatus);

        data = await _grupaService.Select(groStatus);
    }

    private async Task OnStatusChange()
    {
        groStatus = groParam[valStatus];
        data = await _grupaService.Select(groStatus);
    }

    void ShowTooltip(ElementReference elementReference, TooltipOptions options = null) => _tooltipService.Open(elementReference, "Hello!", options);

    void OnBuild()
    {
        _dialogService.Alert($"Funkcja w budowie", "Uwaga", new AlertOptions() { OkButtonText = "Zamknij" });
    }

    async Task OnDetail()
    {
        var groID = 100;

        await _dialogService.OpenSideAsync<Detail>($"Szczegóły {groID}", new Dictionary<string, object>() { { "groID", groID } }, new SideDialogOptions { Position = DialogPosition.Right, Width = "700px" });
    }
}
