@using indigoERP.Domain.Dtos._Podpis
@using indigoERP.Domain.ViewModels._Administracja
@using indigoERP.Domain.ViewModels._Podpis
@using indigoERP.Service.Interfaces._Administrator
@using indigoERP.Service.Interfaces._Podpis

@inject IPodpisGrupaService _podpisGrupaService
@inject IGrupaService _grupaService
@inject DialogService _dialogService
@inject NotificationService _notificationService

<RadzenStack Gap="0.75rem" Class="p-3">
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
        <RadzenDropDown Data="@groups" TextProperty="groNazwa" ValueProperty="groID" TValue="int"
                        @bind-Value="@wybranaGrupaID" AllowFiltering="true"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Style="width:280px" Placeholder="Wybierz grupę" />
        <RadzenButton Text="Dodaj" Icon="add_circle" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Click="@InsertRow" Disabled="@(wybranaGrupaID <= 0)" />
        <RadzenButton Text="Zamknij" Icon="close" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@Close" />
    </RadzenStack>

    @if (data == null)
    {
        <Load />
    }
    else
    {
        <RadzenDataGridApp @ref="grid" Data="@data" TItem="PodpisGrupaViewModel" Density="Density.Compact"
                        AllowPaging="true" PageSize="18" AllowSorting="true">
            <Columns>
                <RadzenDataGridColumn TItem="PodpisGrupaViewModel" Property="pdgID" Title="ID" Width="70px" />
                <RadzenDataGridColumn TItem="PodpisGrupaViewModel" Property="groNazwa" Title="Grupa" />
                <RadzenDataGridColumn TItem="PodpisGrupaViewModel" Filterable="false" Sortable="false" Width="90px" TextAlign="TextAlign.Center">
                    <Template Context="row">
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(_ => DeleteRow(row))" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGridApp>
    }
</RadzenStack>

@code {
    [Parameter]
    public int PodpisID { get; set; }

    private RadzenDataGridApp<PodpisGrupaViewModel>? grid;
    private List<PodpisGrupaViewModel>? data;
    private List<GrupaViewModel> groups = new();
    private int wybranaGrupaID;

    protected override async Task OnInitializedAsync()
    {
        groups = (await _grupaService.Select("*")).ToList();
        await LoadData();
    }

    private async Task LoadData()
    {
        data = (await _podpisGrupaService.SelectByPodpis(PodpisID, "*")).ToList();
    }

    private async Task InsertRow()
    {
        var dto = new PodpisGrupaDto { pdgPodpisID = PodpisID, pdgGrupaID = wybranaGrupaID, pdgStatus = "2" };
        var response = await _podpisGrupaService.Insert(dto);
        ShowResponse(response.Code, "Grupa została przypisana do szablonu.", response.Message);

        if (response.Code >= 200 && response.Code < 300)
        {
            wybranaGrupaID = 0;
        }

        await LoadData();
    }

    private async Task DeleteRow(PodpisGrupaViewModel row)
    {
        var confirmed = await _dialogService.Confirm($"Usunąć przypisanie grupy '{row.groNazwa}'?", "Potwierdzenie", new ConfirmOptions { OkButtonText = "Usuń", CancelButtonText = "Anuluj" });

        if (confirmed == true)
        {
            var response = await _podpisGrupaService.Delete(row.pdgID);
            ShowResponse(response.Code, "Przypisanie zostało usunięte.", response.Message);
            await LoadData();
        }
    }

    private void Close()
    {
        _dialogService.CloseSide(null);
    }

    private void ShowResponse(int code, string successMessage, string? errorMessage)
    {
        _notificationService.Notify(new NotificationMessage
        {
            Severity = code >= 200 && code < 300 ? NotificationSeverity.Success : NotificationSeverity.Error,
            Summary = code >= 200 && code < 300 ? "Gotowe" : "Błąd",
            Detail = code >= 200 && code < 300 ? successMessage : errorMessage ?? "Operacja nie powiodła się.",
            Duration = 5000
        });
    }
}
