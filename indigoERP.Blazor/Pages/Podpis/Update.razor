@using indigoERP.Domain.ViewModels._Podpis

@inject DialogService _dialogService

<RadzenStack Gap="1rem" Class="p-3">
    <RadzenFormField Text="Status" Style="width:100%">
        <RadzenDropDown Data="@StatusOptions" TextProperty="Text" ValueProperty="Value" @bind-Value="@Model.pdpStatus" Style="width:100%" />
    </RadzenFormField>
    <RadzenFormField Text="Nazwa" Style="width:100%">
        <RadzenTextBox @bind-Value="@Model.pdpNazwa" Style="width:100%" />
    </RadzenFormField>
    <RadzenFormField Text="Opis" Style="width:100%">
        <RadzenTextArea @bind-Value="@Model.pdpOpis" Rows="2" Style="width:100%" />
    </RadzenFormField>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <RadzenCheckBox TValue="bool" @bind-Value="@Model.pdpDomyslny" />
        <RadzenLabel Text="Szablon domyślny (używany, gdy brak innego przypisania)" />
    </RadzenStack>
    <RadzenFormField Text="Treść podpisu" Style="width:100%">
        <RadzenHtmlEditor @bind-Value="@Model.pdpTresc" Style="height:280px" />
    </RadzenFormField>
    <RadzenText TextStyle="TextStyle.Caption">
        Dostępne tokeny podstawiane danymi użytkownika: {Imie}, {Nazwisko}, {ImieNazwisko}, {Stanowisko}, {Dzial}, {Telefon}, {Komorka}, {Email}.
    </RadzenText>
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
        <RadzenButton Text="Anuluj" Icon="cancel" ButtonStyle="ButtonStyle.Light" Click="@Cancel" />
        <RadzenButton Text="Zapisz" Icon="save" ButtonStyle="ButtonStyle.Primary" Click="@Save" />
    </RadzenStack>
</RadzenStack>

@code {
    [Parameter]
    public PodpisViewModel Model { get; set; } = new();

    private readonly List<StatusOption> StatusOptions = new()
    {
        new("Aktywne", "2"),
        new("Anulowane", "1")
    };

    private void Save()
    {
        _dialogService.CloseSide(Model);
    }

    private void Cancel()
    {
        _dialogService.CloseSide(null);
    }

    private sealed record StatusOption(string Text, string Value);
}
