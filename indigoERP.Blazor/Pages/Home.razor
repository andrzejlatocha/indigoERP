@page "/"

@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JSRuntime
@inject IHomeService _homeService
@inject AuthenticationStateProvider AuthenticationStateProvider

@using Microsoft.JSInterop;
@using indigoERP.Domain.ViewModels;
@using indigoERP.Service.Interfaces;

<PageTitle>Home</PageTitle>

<div class="home-page main-image">
    <aside class="home-sidebar">
        <nav class="home-shortcuts" aria-label="Skróty">
            <a class="home-shortcut home-shortcut--huta-forms" href="https://deimos.hcz.com.pl:8400/index.html?id=M10001">
                <span class="home-shortcut__icon" aria-hidden="true">
                    <i class="fa-solid fa-table-cells-large"></i>
                </span>
                <span class="home-shortcut__body">
                    <span class="home-shortcut__title">hutaForms</span>
                    <span class="home-shortcut__text">Formularze Huty Częstochowa</span>
                </span>
            </a>
            <a class="home-shortcut home-shortcut--helpdesk" href="https://prometeusz.hcz.com.pl">
                <span class="home-shortcut__icon">
                    <img src="images/helpdesk.png" alt="" />
                </span>
                <span class="home-shortcut__body">
                    <span class="home-shortcut__title">IT Support</span>
                    <span class="home-shortcut__text">System pomocy Działu IT</span>
                </span>
            </a>
            <a class="home-shortcut home-shortcut--outlook" href="https://outlook.office.com/mail/">
                <span class="home-shortcut__icon">
                    <img src="images/outlook.png" alt="" />
                </span>
                <span class="home-shortcut__body">
                    <span class="home-shortcut__title">Poczta</span>
                    <span class="home-shortcut__text">Outlook w przeglądarce</span>
                </span>
            </a>
            <a class="home-shortcut home-shortcut--calendar" href="https://outlook.office.com/calendar/">
                <span class="home-shortcut__icon">
                    <img src="images/calendar.png" alt="" />
                </span>
                <span class="home-shortcut__body">
                    <span class="home-shortcut__title">Kalendarz</span>
                    <span class="home-shortcut__text">Organizacja czasu i spotkań</span>
                </span>
            </a>
            <a class="home-shortcut home-shortcut--onedrive" href="https://hutaczestochowa-my.sharepoint.com/">
                <span class="home-shortcut__icon">
                    <img src="images/onedrive.png" alt="" />
                </span>
                <span class="home-shortcut__body">
                    <span class="home-shortcut__title">OneDrive</span>
                    <span class="home-shortcut__text">Dokumenty w chmurze</span>
                </span>
            </a>
            <a class="home-shortcut home-shortcut--form" href="/support">
                <span class="home-shortcut__icon home-shortcut__icon--mail" aria-hidden="true">
                    <i class="fa-solid fa-envelope"></i>
                </span>
                <span class="home-shortcut__title">Formularz zgłoszenia</span>
            </a>
        </nav>
    </aside>
    <main class="home-content">
        @if (browserWarrningVisible)
        {
            <section class="home-alerts">
                <RadzenAlert ShowIcon="false" AlertStyle="AlertStyle.Danger" AllowClose="false" Shade="Shade.Light" Size="AlertSize.Small"
                             Variant="Variant.Filled" Visible="true" class="w-100">
                    <i class="fa-solid fa-light-emergency-on fa-lg me-3"></i>
                    Zalecamy używanie przeglądarki Microsoft Edge w celu wykorzystywania wszystkich możliwości Microsoft 365!
                </RadzenAlert>
            </section>
        }
        <section class="application-grid" aria-label="Aplikacje">
            @if (data == null)
            {
                <div class="home-loader">
                    <div class="spinner-border text-warning" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else
            {
                @foreach (var item in data)
                {
                    <a href="@item.appLink" class="application-card">
                        <span class="application-card__icon">
                            <img src="@item.appIkona" alt="Ikona" />
                        </span>
                        <span class="application-card__body">
                            <span class="application-card__title">@item.appNazwa</span>
                            <span class="application-card__text">@item.appOpis</span>
                        </span>
                    </a>
                }
            }
        </section>
        <section class="legacy-apps" aria-label="Stare aplikacje">
            <div class="legacy-apps__title">Stare aplikacje (Intranet)</div>
            <div class="legacy-grid">
                @foreach (var app in legacyApps)
                {
                    <a href="@app.Url" class="btn btn-warning legacy-button">
                        <i class="fa-solid @app.Icon" aria-hidden="true"></i>
                        <span>@app.Name</span>
                    </a>
                }
            </div>
        </section>
    </main>
</div>

@code{
    IEnumerable<AplikacjaViewModel>? data;
    bool browserWarrningVisible;

    // Skróty do aplikacji starego Intranetu (5 kolumn x 2 rzędy). Adresy do uzupełnienia - na razie strona główna Intranetu.
    private const string LegacyIntranetUrl = "https://intranet.hcz.com.pl/";

    private static readonly LegacyApp[] legacyApps =
    {
        new("atacamaDMS", "fa-folder-open", LegacyIntranetUrl),
        new("hydraRCP", "fa-clock", LegacyIntranetUrl),
        new("atestyHCZ", "fa-certificate", LegacyIntranetUrl),
        new("magazynBHP", "fa-helmet-safety", LegacyIntranetUrl),
        new("cerberTMS", "fa-truck", LegacyIntranetUrl),
        new("warehouseBI", "fa-chart-column", LegacyIntranetUrl),
        new("kosztyKJ", "fa-coins", LegacyIntranetUrl),
        new("transportRAP", "fa-truck-fast", LegacyIntranetUrl),
        new("bhpAPP", "fa-shield-halved", LegacyIntranetUrl),
        new("bespinEWA", "fa-clipboard-list", LegacyIntranetUrl)
    };

    private sealed record LegacyApp(string Name, string Icon, string Url);

    protected override async Task OnInitializedAsync()
    {

    }

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var usrID = int.TryParse(authState.User.FindFirst("usrID")?.Value, out var parsedUsrID) ? parsedUsrID : 0;

        data = await _homeService.SelectAplikacjaByUzytkownik(usrID, "2");

        //await VerifyBrowser();
    }

    async Task VerifyBrowser()
    {
        string verifyInfo = await JSRuntime.InvokeAsync<string>(identifier: "identifyBrowser");

        browserWarrningVisible = verifyInfo == "yes";
    }
}
