@inject DialogService _dialogService

<RadzenStack Gap="1rem" Class="p-3">
    <RadzenFormField Text="Status" Style="width:100%">
        <RadzenDropDown Data="@StatusOptions" TextProperty="Text" ValueProperty="Value" @bind-Value="@Model.msgStatus" Style="width:100%" />
    </RadzenFormField>
    <RadzenFormField Text="Temat" Style="width:100%">
        <RadzenTextBox @bind-Value="@Model.msgTemat" Style="width:100%" />
    </RadzenFormField>
    <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem">
        <RadzenFormField Text="Typ" Style="width:100%">
            <RadzenNumeric TValue="byte?" @bind-Value="@Model.msgTyp" Style="width:100%" />
        </RadzenFormField>
        <RadzenFormField Text="Język" Style="width:100%">
            <RadzenTextBox @bind-Value="@Model.msgJezyk" Style="width:100%" />
        </RadzenFormField>
    </RadzenStack>
    <RadzenFormField Text="Treść" Style="width:100%">
        <RadzenHtmlEditor @bind-Value="@Model.msgTresc" Style="height:280px" />
    </RadzenFormField>
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
        <RadzenButton Text="Zapisz" Icon="save" ButtonStyle="ButtonStyle.Primary" Click="@Save" />
        <RadzenButton Text="Anuluj" Icon="cancel" ButtonStyle="ButtonStyle.Light" Click="@Cancel" />
    </RadzenStack>
</RadzenStack>

@code {
    [Parameter]
    public WiadomoscWzorzecViewModel Model { get; set; } = new();

    private readonly List<StatusOption> StatusOptions = new()
    {
        new("Aktywne", "2"),
        new("Anulowane", "1")
    };

    private void Save()
    {
        _dialogService.CloseSide(Model);
    }

    private void Cancel()
    {
        _dialogService.CloseSide(null);
    }

    private sealed record StatusOption(string Text, string Value);
}
