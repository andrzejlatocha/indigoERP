@page "/polecenie-sluzbowe"
@attribute [Authorize]
@using indigoERP.Domain.ViewModels._Wspolne
@using indigoERP.Service.Interfaces._Wspolne
@using Microsoft.AspNetCore.Authorization

@inject IPolecenieSluzboweService _polecenieService
@inject DialogService _dialogService
@inject NotificationService _notificationService

<PageTitle>Przepisy wewnętrzne</PageTitle>

<div class="ps-strona p-3">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap" Class="mb-3">
        <div class="me-2">
            <h3 class="mb-0">Przepisy wewnętrzne</h3>
            <p class="text-muted mb-0 small">Obowiązujące przepisy wewnętrzne</p>
        </div>
        <RadzenDropDown TValue="int?" Data="@WyborFolderow" TextProperty="Nazwa" ValueProperty="Id" @bind-Value="@katalogID"
                        Change="@(_ => PobierzAsync())" Style="width:260px" />
        <RadzenDropDown TValue="int" Data="@Lata" @bind-Value="@rok" Style="width:110px" Change="@(_ => StateHasChanged())" />
        <RadzenTextBox @bind-Value="@szukaj" Placeholder="Szukaj w nazwie lub opisie" Style="width:340px"
                       Change="@(_ => SzukajAsync())" />
        <RadzenButton Text="Szukaj" Icon="search" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Click="@SzukajAsync" IsBusy="@ladowanie" />
        <RadzenButton Text="Wyczyść" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@WyczyscAsync" />
        <div class="ms-auto"></div>
        <RadzenButton Icon="view_list" Size="ButtonSize.Small" Variant="@(tryb == Tryb.Lista ? Variant.Filled : Variant.Outlined)"
                      ButtonStyle="ButtonStyle.Secondary" Click="@(() => tryb = Tryb.Lista)" title="Lista" />
        <RadzenButton Icon="grid_view" Size="ButtonSize.Small" Variant="@(tryb == Tryb.Siatka ? Variant.Filled : Variant.Outlined)"
                      ButtonStyle="ButtonStyle.Secondary" Click="@(() => tryb = Tryb.Siatka)" title="Siatka" />
    </RadzenStack>

    @if (ladowanie)
    {
        <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" Style="height:4px" />
    }
    else if (WidoczneWRoku.Count == 0)
    {
        <p class="text-muted">Brak przepisów spełniających kryteria.</p>
    }
    else if (tryb == Tryb.Siatka)
    {
        <div class="ps-scroll">
            <div class="ps-siatka">
                @foreach (var przepis in WidoczneWRoku)
                {
                    <div class="ps-kafelek" title="@Tytul(przepis)" role="button" @onclick="@(() => OtworzPdfAsync(przepis))">
                        <i class="fa-duotone fa-light fa-file-pdf ps-ikona"></i>
                        <div class="ps-tytul">@Tytul(przepis)</div>
                        <div class="ps-numer">@(przepis.pliData?.ToString("dd.MM.yyyy"))</div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <RadzenDataGrid Data="@WidoczneWRoku" TItem="PrzepisWewnetrznyViewModel" Density="Density.Compact"
                        AllowSorting="true" AllowFiltering="false" Style="height:calc(100vh - 12rem)"
                        RowClick="@(args => OtworzPdfAsync(args.Data!))">
            <Columns>
                <RadzenDataGridColumn TItem="PrzepisWewnetrznyViewModel" Property="pliOpis" Title="Tytuł" />
                <RadzenDataGridColumn TItem="PrzepisWewnetrznyViewModel" Property="pliNazwa" Title="Nazwa pliku" Width="260px" />
                <RadzenDataGridColumn TItem="PrzepisWewnetrznyViewModel" Property="pliData" Title="Data" Width="140px"
                                      FormatString="{0:dd.MM.yyyy}" />
            </Columns>
        </RadzenDataGrid>
    }
</div>

@code {
    private enum Tryb { Lista, Siatka }

    private List<PrzepisWewnetrznyViewModel> przepisy = new();
    private List<FolderOpcja> foldery = new();
    private int? katalogID;

    // Pierwsza pozycja combo to „Wszystkie” (cała HUTA); pozostałe to foldery pierwszego poziomu HUTY.
    private sealed record FolderOpcja(int? Id, string Nazwa);

    private List<FolderOpcja> WyborFolderow => [new FolderOpcja(null, "Wszystkie"), .. foldery];
    private int rok = DateTime.Now.Year;
    private string? szukaj;
    private bool ladowanie = true;
    private Tryb tryb = Tryb.Siatka;

    // Tytuł: opis pliku, a gdy go nie ma, nazwa pliku.
    private static string Tytul(PrzepisWewnetrznyViewModel p) => string.IsNullOrWhiteSpace(p.pliOpis) ? p.pliNazwa : p.pliOpis;

    // Lata z dat przepisów oraz bieżący rok.
    private List<int> Lata => przepisy
        .Where(p => p.pliData.HasValue)
        .Select(p => p.pliData!.Value.Year)
        .Append(DateTime.Now.Year)
        .Distinct()
        .OrderByDescending(y => y)
        .ToList();

    // Przepisy bez daty są widoczne zawsze; z datą - tylko w wybranym roku.
    private List<PrzepisWewnetrznyViewModel> WidoczneWRoku => przepisy
        .Where(p => !p.pliData.HasValue || p.pliData.Value.Year == rok)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await PobierzFolderowAsync();
        await PobierzAsync();
    }

    private async Task PobierzFolderowAsync()
    {
        try
        {
            foldery = (await _polecenieService.SelectKatalogi()).Select(k => new FolderOpcja(k.dirID, k.dirNazwa)).ToList();
        }
        catch (HttpRequestException)
        {
            foldery = new List<FolderOpcja>();
            Powiadom(NotificationSeverity.Warning, "Foldery", "Nie udało się pobrać listy folderów.");
        }
    }

    private async Task SzukajAsync()
    {
        await PobierzAsync();
    }

    private async Task WyczyscAsync()
    {
        szukaj = null;
        await PobierzAsync();
    }

    private async Task PobierzAsync()
    {
        ladowanie = true;

        try
        {
            przepisy = (await _polecenieService.SelectPubliczne(szukaj, katalogID)).ToList();
        }
        catch (HttpRequestException)
        {
            przepisy = new List<PrzepisWewnetrznyViewModel>();
            Powiadom(NotificationSeverity.Error, "Błąd", "Nie udało się pobrać przepisów wewnętrznych.");
        }
        finally
        {
            ladowanie = false;
        }
    }

    private async Task OtworzPdfAsync(PrzepisWewnetrznyViewModel przepis)
    {
        try
        {
            var pdf = await _polecenieService.Pdf(przepis.pliID);

            if (pdf == null)
            {
                Powiadom(NotificationSeverity.Warning, "Brak dokumentu", "Nie znaleziono pliku PDF tego przepisu.");
                return;
            }

            var zrodlo = "data:application/pdf;base64," + Convert.ToBase64String(pdf);

            await _dialogService.OpenAsync<PolecenieSluzbowePdfOkno>(Tytul(przepis),
                new Dictionary<string, object?> { ["Zrodlo"] = zrodlo },
                new DialogOptions { Width = "90vw", Height = "90vh", Resizable = true, Draggable = true });
        }
        catch (HttpRequestException)
        {
            Powiadom(NotificationSeverity.Error, "Błąd", "Nie udało się pobrać dokumentu PDF.");
        }
    }

    private void Powiadom(NotificationSeverity waga, string tytul, string szczegoly) =>
        _notificationService.Notify(new NotificationMessage { Severity = waga, Summary = tytul, Detail = szczegoly, Duration = 8000 });
}
