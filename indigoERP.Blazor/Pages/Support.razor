@page "/support"
<PageTitle>Support - indigoERP</PageTitle>

@using System.Net.Mail;
@using System.Net;
@using indigoERP.Domain.Entities
@using Microsoft.AspNetCore.Hosting

@inject ILogger<SupportMessage> _logger
@inject AuthenticationStateProvider _authenticationStateProvider
@inject NavigationManager _navigationManager
@inject DialogService _dialogService
@inject IWebHostEnvironment _webHostEnvironment

@if (supportMessage == null)
{
    <Load />
}
else
{
    <div class="row w-100 mt-2">
        <div class="col-6 offset-3">
            <div class="card">
                <div class="card-body">
                    <h3 class="card-title">Zgłoszenie do IT Support</h3>
                    <RadzenTemplateForm Data="@supportMessage" Submit="@((SupportMessage args) => Submit(args))" Class="w-100">
                        <DataAnnotationsValidator />
                        <RadzenRow Gap="2rem" Class="w-100">
                            <RadzenFieldset Text="Wiadomość" Class="w-100">
                                <RadzenStack Gap="1rem">
                                    <RadzenRow AlignItems="AlignItems.Start">
                                        <RadzenColumn Size="12" SizeMD="2">
                                            <RadzenLabel Text="Temat" />
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="10">
                                            <RadzenTextBox @bind-Value="supportMessage.msgTemat" AllowClear="true" Placeholder="Temat" Name="Temat"
                                                           Class="w-100">
                                            </RadzenTextBox>
                                            <ValidationMessage For="() => supportMessage.msgTemat" />
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="2">
                                            <RadzenLabel Text="Wiadomość" />
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="10">
                                            <RadzenTextArea @bind-Value="supportMessage.msgWiadomosc" AllowClear="true" Placeholder="Wiadomość"
                                                            Name="Wiadomość" Class="w-100" Style="height: 180px; min-height: 180px;">
                                            </RadzenTextArea>
                                            <ValidationMessage For="() => supportMessage.msgWiadomosc" />
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenFieldset>
                        </RadzenRow>
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="1rem" Class="rz-mt-8 rz-mb-4">
                            <RadzenButton ButtonType="ButtonType.Submit" Size="ButtonSize.Large" Icon='@(isSending ? "hourglass_empty" : "send")'
                                          Text='@(isSending ? "Wysyłanie..." : "Wyślij")' Disabled="@isSending" />
                            <RadzenButton ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Large" Icon="cancel" Text="Anuluj"
                                          Click="@Cancel" Disabled="@isSending" />
                        </RadzenStack>
                    </RadzenTemplateForm>
                </div>
            </div>               
        </div>
    </div>
}

@code {
    private const string SupportRecipient = "helpdesk@hutaczestochowa.com.pl";
    private const string SupportSmtpHost = "poczta.hcz.com.pl";
    private const int SupportSmtpPort = 25;
    private const string SupportSmtpUser = "support@hcz.com.pl";
    private const string SupportSmtpPassword = "Sup@0928";

    private SupportMessage supportMessage = new SupportMessage();
    private bool isSending;

    protected async override Task OnInitializedAsync()
    {
        var authState = await _authenticationStateProvider.GetAuthenticationStateAsync();
        var uzytkownik = authState.User;

        if (uzytkownik.Identity?.IsAuthenticated == true)
        {
            supportMessage.msgImie = uzytkownik.FindFirst("usrImie")?.Value ?? string.Empty;
            supportMessage.msgNazwisko = uzytkownik.FindFirst("usrNazwisko")?.Value ?? string.Empty;
            supportMessage.msgAdresEmailOd = uzytkownik.FindFirst("usrEmail")?.Value ?? string.Empty;
            supportMessage.msgAdresEmailDo = SupportRecipient;
        }
    }

    private async Task Submit(SupportMessage supportMessage)
    {
        if (isSending)
        {
            return;
        }

        _logger.LogInformation("onValidHandleSubmit called");
        isSending = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            if (string.IsNullOrWhiteSpace(supportMessage.msgAdresEmailOd))
            {
                await _dialogService.Alert("Nie znaleziono adresu email zalogowanego użytkownika.", "Błąd", new AlertOptions() { OkButtonText = "OK" });
                return;
            }

            var templatePath = Path.Combine(_webHostEnvironment.WebRootPath, "support.html");
            var wiadomosc = await File.ReadAllTextAsync(templatePath);
            wiadomosc = wiadomosc.Replace("{{message}}", FormatMessage(supportMessage.msgWiadomosc));
            supportMessage.msgAdresEmailDo = SupportRecipient;

            using (MailMessage mailMessage = new MailMessage { From = new MailAddress(supportMessage.msgAdresEmailOd) })
            {
                MailAddress addTo = new MailAddress(SupportRecipient);

                mailMessage.To.Add(addTo);
                mailMessage.Subject = supportMessage.msgTemat;
                mailMessage.Body = wiadomosc;
                mailMessage.IsBodyHtml = true;
                mailMessage.ReplyToList.Add(new MailAddress(supportMessage.msgAdresEmailOd));
                try
                {
                    using (SmtpClient clientSMTP = new SmtpClient(SupportSmtpHost, SupportSmtpPort))
                    {
                        clientSMTP.Credentials = new NetworkCredential(SupportSmtpUser, SupportSmtpPassword);
                        await clientSMTP.SendMailAsync(mailMessage);
                    }
                }
                catch (SmtpException ex)
                {
                    throw new ApplicationException(String.Format("Klient SMTP wywołał wyjątek {0}", ex.Message));
                }
            }

            await _dialogService.Alert("Twoja wiadomość została wysłana poprawnie.", "Informacja", new AlertOptions() { OkButtonText = "OK" });

            _navigationManager.NavigateTo("/");
        }
        finally
        {
            isSending = false;
        }
    }

    void Cancel()
    {        
        _navigationManager.NavigateTo("/");
    }

    private static string FormatMessage(string message)
    {
        return WebUtility.HtmlEncode(message ?? string.Empty).Replace("\r\n", "<br />").Replace("\n", "<br />");
    }
}
