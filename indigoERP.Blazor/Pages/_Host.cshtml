@page "/"
@using Microsoft.AspNetCore.Components.Web
@namespace indigoERP.Blazor.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <base href="~/" />

    <link href="~/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/fontawesome.min.css" rel="stylesheet" />
    @* <link href="~/css/open-iconic/font/css/open-iconic-bootstrap.min.css" rel="stylesheet" /> *@
    <link id="radzen-theme" href="_content/Radzen.Blazor/css/material-base.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/css/card.css" rel="stylesheet" />
    <link href="~/css/menu.css" rel="stylesheet" />
    <link href="~/indigoERP.Blazor.styles.css" rel="stylesheet" />

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        window.indigoTheme = window.indigoTheme || (function () {
            const storageKey = "indigoERP.darkMode";
            const lightTheme = "_content/Radzen.Blazor/css/material-base.css";
            const darkTheme = "_content/Radzen.Blazor/css/material-dark-base.css";

            function setDarkMode(isDarkMode) {
                const theme = document.getElementById("radzen-theme");

                if (theme) {
                    theme.setAttribute("href", isDarkMode ? darkTheme : lightTheme);
                }

                document.documentElement.setAttribute("data-bs-theme", isDarkMode ? "dark" : "light");
                localStorage.setItem(storageKey, isDarkMode ? "true" : "false");
            }

            function initialize() {
                const isDarkMode = localStorage.getItem(storageKey) === "true";
                setDarkMode(isDarkMode);

                return isDarkMode;
            }

            return {
                initialize,
                setDarkMode
            };
        })();
    </script>
    <script src="~/js/fontawesome.min.js"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js"></script>

    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            Wystąpił błąd. Ta aplikacja może nie odpowiadać, dopóki nie zostanie ponownie załadowana.
        </environment>
        <environment include="Development">
            Wystąpił nieobsługiwany wyjątek. Aby uzyskać szczegółowe informacje, zobacz narzędzia deweloperskie przeglądarki.
        </environment>
        <a href="" class="reload">Wczytaj ponownie</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="_framework/blazor.server.js"></script>
</body>
</html>
