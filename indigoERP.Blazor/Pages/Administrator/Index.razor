@page "/administrator"
@attribute [Authorize(Roles = "HCZ-indigoERP-Administrator")]

<section class="administrator-home">
    <div class="administrator-home__header">
        <h2>Administracja</h2>
        <p>Konfiguracja użytkowników, ról, grup i słowników systemu indigoERP.</p>
    </div>

    <a class="administrator-tile administrator-tile--featured administrator-tile--success" href="/administrator/monitor">
        <span class="administrator-tile__icon">
            <RadzenIcon Icon="monitoring" />
        </span>
        <span class="administrator-tile__content">
            <span class="administrator-tile__title">Monitoring</span>
            <span class="administrator-tile__description">Monitorowanie stanu systemu.</span>
        </span>
    </a>

    <div class="administrator-home__tiles">
        <a class="administrator-tile" href="/administrator/aplikacja">
            <span class="administrator-tile__icon">
                <RadzenIcon Icon="apps" />
            </span>
            <span class="administrator-tile__content">
                <span class="administrator-tile__title">Aplikacje</span>
                <span class="administrator-tile__description">Lista aplikacji i podstawowe ustawienia.</span>
            </span>
        </a>

        <a class="administrator-tile" href="/administrator/rola">
            <span class="administrator-tile__icon">
                <RadzenIcon Icon="admin_panel_settings" />
            </span>
            <span class="administrator-tile__content">
                <span class="administrator-tile__title">Role</span>
                <span class="administrator-tile__description">Role, uprawnienia oraz powiązania.</span>
            </span>
        </a>

        <a class="administrator-tile" href="/administrator/grupa">
            <span class="administrator-tile__icon">
                <RadzenIcon Icon="groups" />
            </span>
            <span class="administrator-tile__content">
                <span class="administrator-tile__title">Grupy</span>
                <span class="administrator-tile__description">Grupy użytkowników i przypisania.</span>
            </span>
        </a>

        <a class="administrator-tile" href="/administrator/uzytkownik">
            <span class="administrator-tile__icon">
                <RadzenIcon Icon="manage_accounts" />
            </span>
            <span class="administrator-tile__content">
                <span class="administrator-tile__title">Użytkownicy</span>
                <span class="administrator-tile__description">Konta użytkowników i członkostwa.</span>
            </span>
        </a>

        <a class="administrator-tile" href="/administrator/aplikacja-usluga-uprawnienie">
            <span class="administrator-tile__icon">
                <RadzenIcon Icon="verified_user" />
            </span>
            <span class="administrator-tile__content">
                <span class="administrator-tile__title">Uprawnienia usługowe</span>
                <span class="administrator-tile__description">Nadania service-to-service między aplikacjami.</span>
            </span>
        </a>

        <a class="administrator-tile" href="/administrator/login-blokada">
            <span class="administrator-tile__icon">
                <RadzenIcon Icon="lock_open" />
            </span>
            <span class="administrator-tile__content">
                <span class="administrator-tile__title">Blokady logowania</span>
                <span class="administrator-tile__description">Konta zablokowane przez ban manager.</span>
            </span>
        </a>

        <a class="administrator-tile" href="/administrator/serwer">
            <span class="administrator-tile__icon">
                <RadzenIcon Icon="dns" />
            </span>
            <span class="administrator-tile__content">
                <span class="administrator-tile__title">Serwery</span>
                <span class="administrator-tile__description">Rejestr monitorowanych serwerów.</span>
            </span>
        </a>
    </div>
</section>
