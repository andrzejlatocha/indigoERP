@using indigoERP.Domain.ViewModels

@inject DialogService _dialogService

<RadzenStack Gap="1rem" Class="p-3">
    <RadzenFormField Text="Symbol" Style="width:100%">
        <RadzenNumeric TValue="int" @bind-Value="@Model.appID" Min="101" Disabled="@(!IsInsert)" Style="width:100%" />
    </RadzenFormField>
    <RadzenFormField Text="Status" Style="width:100%">
        <RadzenDropDown Data="@StatusOptions" TextProperty="Text" ValueProperty="Value" @bind-Value="@Model.appStatus" Style="width:100%" />
    </RadzenFormField>
    <RadzenFormField Text="Nazwa" Style="width:100%">
        <RadzenTextBox @bind-Value="@Model.appNazwa" Style="width:100%" />
    </RadzenFormField>
    <RadzenFormField Text="Wersja" Style="width:100%">
        <RadzenTextBox @bind-Value="@Model.appWersja" Style="width:100%" />
    </RadzenFormField>
    <RadzenFormField Text="Opis" Style="width:100%">
        <RadzenTextArea @bind-Value="@Model.appOpis" Rows="3" Style="width:100%" />
    </RadzenFormField>
    <RadzenFormField Text="Link" Style="width:100%">
        <RadzenTextBox @bind-Value="@Model.appLink" Style="width:100%" />
    </RadzenFormField>
    <RadzenFormField Text="Ikona" Style="width:100%">
        <RadzenTextBox @bind-Value="@Model.appIkona" Style="width:100%" />
    </RadzenFormField>
    <RadzenFormField Text="Folder" Style="width:100%">
        <RadzenTextBox @bind-Value="@Model.appFolder" Style="width:100%" />
    </RadzenFormField>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <RadzenCheckBox TValue="bool" @bind-Value="@Model.appWyswietl" />
        <RadzenLabel Text="Wyświetlaj" />
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
        <RadzenButton Text="Zapisz" Icon="save" ButtonStyle="ButtonStyle.Primary" Click="@Save" />
        <RadzenButton Text="Anuluj" Icon="cancel" ButtonStyle="ButtonStyle.Light" Click="@Cancel" />
    </RadzenStack>
</RadzenStack>

@code {
    [Parameter]
    public AplikacjaViewModel Model { get; set; } = new();

    [Parameter]
    public bool IsInsert { get; set; }

    private readonly List<StatusOption> StatusOptions = new()
    {
        new("Aktywne", "2"),
        new("Anulowane", "1")
    };

    private void Save()
    {
        _dialogService.CloseSide(Model);
    }

    private void Cancel()
    {
        _dialogService.CloseSide(null);
    }

    private sealed record StatusOption(string Text, string Value);
}
