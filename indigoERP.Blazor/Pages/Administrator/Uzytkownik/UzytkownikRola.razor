@using indigoERP.Domain.Dtos._Administrator
@using indigoERP.Domain.ViewModels._Administracja
@using indigoERP.Service.Interfaces._Administrator

@inject IUzytkownikService _uzytkownikService
@inject IRolaService _rolaService
@inject DialogService _dialogService
@inject NotificationService _notificationService

<RadzenStack Gap="0.75rem" Class="p-3">
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
        <RadzenButton Text="Dodaj" Icon="add_circle" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Click="@InsertRow" />
        <RadzenButton Text="Zamknij" Icon="close" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@Close" />
    </RadzenStack>

    @if (data == null)
    {
        <Load />
    }
    else
    {
        <RadzenDataGridApp @ref="grid" Data="@data" TItem="UzytkownikRolaViewModel" Density="Density.Compact"
                        SelectionMode="DataGridSelectionMode.Single" @bind-Value="@selectedItems"
                        AllowPaging="true" PageSize="18" AllowSorting="true" EditMode="DataGridEditMode.Single"
                        RowCreate="@OnCreateRow">
            <Columns>
                <RadzenDataGridColumn TItem="UzytkownikRolaViewModel" Property="cwrID" Title="ID" Width="80px" />
                <RadzenDataGridColumn TItem="UzytkownikRolaViewModel" Property="srlID" Title="Rola">
                    <Template Context="row">
                        @row.srlNazwa
                    </Template>
                    <EditTemplate Context="row">
                        <RadzenDropDown Data="@AvailableRoles" TextProperty="srlNazwa" ValueProperty="srlID" TValue="int"
                                        @bind-Value="@row.srlID" AllowFiltering="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="UzytkownikRolaViewModel" Property="srlStatus" Title="S" Width="70px">
                    <Template Context="row">
                        <RadzenImage Path="@($"Images/status/{row.srlStatus}.png")" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="UzytkownikRolaViewModel" Property="uwgDziedziczy" Title="Dz." Width="70px">
                    <Template Context="row">
                        <RadzenCheckBox TValue="bool" Value="@row.uwgDziedziczy" Disabled="true" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="UzytkownikRolaViewModel" Filterable="false" Sortable="false" Width="120px" TextAlign="TextAlign.Center">
                    <Template Context="row">
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Small"
                                      Disabled="@(row.uwgDziedziczy || row.cwrID <= 0)" Click="@(_ => DeleteRow(row))" />
                    </Template>
                    <EditTemplate Context="row">
                        <RadzenButton Icon="save" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Small"
                                      Click="@(_ => SaveRow(row))" />
                        <RadzenButton Icon="cancel" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small"
                                      Click="@(_ => CancelEdit(row))" />
                    </EditTemplate>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGridApp>
    }
</RadzenStack>

@code {
    [Parameter]
    public int UzytkownikID { get; set; }

    private RadzenDataGridApp<UzytkownikRolaViewModel>? grid;
    private IList<UzytkownikRolaViewModel> selectedItems = new List<UzytkownikRolaViewModel>();
    private List<UzytkownikRolaViewModel>? data;
    private List<RolaViewModel> roles = new();
    private IEnumerable<RolaViewModel> AvailableRoles => roles.Where(w => w.srlID > 0 && data?.All(a => a.srlID != w.srlID) != false);

    protected override async Task OnInitializedAsync()
    {
        roles = (await _rolaService.Select("*")).ToList();
        await LoadData();
    }

    private async Task LoadData()
    {
        data = (await _uzytkownikService.SelectRolaByUzytkownik(-1, UzytkownikID, "*")).ToList();
    }

    private async Task InsertRow()
    {
        if (grid == null)
        {
            return;
        }

        var role = AvailableRoles.FirstOrDefault();

        if (role == null)
        {
            ShowResponse(409, string.Empty, "Brak ról możliwych do dodania do tego użytkownika.");
            return;
        }

        await grid.InsertRow(new UzytkownikRolaViewModel { usrID = UzytkownikID, srlID = role.srlID, usrStatus = "2", srlStatus = "2" });
    }

    private async Task SaveRow(UzytkownikRolaViewModel row)
    {
        if (grid != null)
        {
            await grid.UpdateRow(row);
        }
    }

    private async Task CancelEdit(UzytkownikRolaViewModel row)
    {
        grid?.CancelEditRow(row);
        await LoadData();
    }

    private async Task OnCreateRow(UzytkownikRolaViewModel row)
    {
        if (row.srlID <= 0)
        {
            ShowResponse(400, string.Empty, "Wybierz rolę.");
            return;
        }

        var response = await _rolaService.InsertCzlonek(new RolaCzlonkowieDto { cwrRolaID = row.srlID, cwrUzytkownikID = UzytkownikID, cwrStatus = "2" });
        var success = response.Code >= 200 && response.Code < 300;
        ShowResponse(response.Code, "Rola została dodana do użytkownika.", response.Message);

        if (success)
        {
            grid?.CancelEditRow(row);
        }

        await LoadData();
        SelectUserRole(success ? response.Id : null, success ? row.srlID : 0);

        if (grid != null)
        {
            await grid.Reload();
        }
    }

    private async Task DeleteRow(UzytkownikRolaViewModel row)
    {
        if (row.uwgDziedziczy || row.cwrID <= 0)
        {
            ShowResponse(400, string.Empty, "Można usunąć tylko bezpośrednio przypisaną rolę.");
            return;
        }

        var options = new ConfirmOptions { OkButtonText = "Usuń", CancelButtonText = "Anuluj" };
        var confirmed = await _dialogService.Confirm($"Usunąć rolę '{row.srlNazwa}' z użytkownika?", "Potwierdzenie", options);

        if (confirmed == true)
        {
            var response = await _rolaService.DeleteCzlonek(row.cwrID);
            ShowResponse(response.Code, "Rola została usunięta z użytkownika.", response.Message);
            await LoadData();
            selectedItems = new List<UzytkownikRolaViewModel>();
        }
    }

    private void SelectUserRole(int? cwrID, int srlID)
    {
        var selected = data?.FirstOrDefault(w => cwrID > 0 ? w.cwrID == cwrID.Value : w.srlID == srlID);
        selectedItems = selected == null ? new List<UzytkownikRolaViewModel>() : new List<UzytkownikRolaViewModel> { selected };
    }

    private void Close()
    {
        _dialogService.CloseSide(null);
    }

    private void ShowResponse(int code, string successMessage, string? errorMessage)
    {
        _notificationService.Notify(new NotificationMessage
        {
            Severity = code >= 200 && code < 300 ? NotificationSeverity.Success : NotificationSeverity.Error,
            Summary = code >= 200 && code < 300 ? "Gotowe" : "Błąd",
            Detail = code >= 200 && code < 300 ? successMessage : errorMessage ?? "Operacja nie powiodła się.",
            Duration = 5000
        });
    }
}
