@using indigoERP.Domain.Enumerators._Slownik
@using indigoERP.Domain.ViewModels._Administracja

@inject DialogService _dialogService

<RadzenStack Gap="1rem" Class="p-3">
    <RadzenFormField Text="Typ" Style="width:100%">
        <RadzenDropDown Data="@Typy" TextProperty="styOpis" ValueProperty="styKOD" @bind-Value="@Model.srvSerwerTypKOD" Style="width:100%" />
    </RadzenFormField>
    <RadzenFormField Text="Status" Style="width:100%">
        <RadzenDropDown Data="@StatusOptions" TextProperty="Text" ValueProperty="Value" @bind-Value="@Model.srvStatus" Style="width:100%" />
    </RadzenFormField>
    <RadzenFormField Text="Nazwa" Style="width:100%">
        <RadzenTextBox @bind-Value="@Model.srvNazwa" Style="width:100%" />
    </RadzenFormField>
    <RadzenFormField Text="IP / host / URL" Style="width:100%">
        <RadzenTextBox @bind-Value="@Model.srvAdres" Style="width:100%" />
    </RadzenFormField>
    <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary">
        WIN: adres IP/host do ping. SQL/Oracle: host (port osobno niżej). API: pełny adres URL wraz ze schematem, np. https://intranet.hcz.com.pl albo http://serwer/... (część API działa po http, część po https — trzeba podać wprost).
    </RadzenText>
    <RadzenFormField Text="Port (opcjonalnie)" Style="width:100%">
        <RadzenNumeric TValue="int?" @bind-Value="@Model.srvPort" Style="width:100%" />
    </RadzenFormField>
    <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary">
        SQL/Oracle: domyślnie 1433/1521 jeśli puste. API: jeśli podane, nadpisuje port w adresie URL powyżej (np. adres "http://intranet.hcz.com.pl" + port 9130 → sprawdzany jest "http://intranet.hcz.com.pl:9130").
    </RadzenText>
    <RadzenFormField Text="Opis" Style="width:100%">
        <RadzenTextArea @bind-Value="@Model.srvOpis" Rows="3" Style="width:100%" />
    </RadzenFormField>
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
        <RadzenButton Text="Anuluj" Icon="cancel" ButtonStyle="ButtonStyle.Light" Click="@Cancel" />
        <RadzenButton Text="Zapisz" Icon="save" ButtonStyle="ButtonStyle.Primary" Click="@Save" />
    </RadzenStack>
</RadzenStack>

@code {
    [Parameter]
    public SerwerViewModel Model { get; set; } = new();

    [Parameter]
    public bool IsInsert { get; set; }

    [Parameter]
    public List<SerwerTypEnumerator> Typy { get; set; } = new();

    private readonly List<StatusOption> StatusOptions = new()
    {
        new("Aktywne", "2"),
        new("Anulowane", "1")
    };

    private void Save()
    {
        _dialogService.CloseSide(Model);
    }

    private void Cancel()
    {
        _dialogService.CloseSide(null);
    }

    private sealed record StatusOption(string Text, string Value);
}
