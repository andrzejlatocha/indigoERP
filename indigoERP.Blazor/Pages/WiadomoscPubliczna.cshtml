@page "/wiadomosc"
@model indigoERP.Blazor.Pages.WiadomoscPublicznaModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Components.Web
@using indigoERP.Blazor.Pages

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Wiadomości</title>
    <base href="~/" />
    <link href="~/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/fontawesome.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/css/glos-hutnika.css" rel="stylesheet" />
    @if (Model.MozeZarzadzac)
    {
        <link href="_content/Radzen.Blazor/css/material-base.css" rel="stylesheet" />
        <script src="_content/Radzen.Blazor/Radzen.Blazor.js"></script>
    }
</head>
<body>
    <nav class="navbar navbar-dark bg-dark header-color header-navbar">
        <div class="container-fluid">
            <span class="navbar-brand">
                <img class="app-header-logo" src="~/images/logo_white.svg" />
                Wiadomości
            </span>
        </div>
    </nav>

    <div class="glos-page">
        @if (Model.Wybrana != null)
        {
            <div class="glos-naglowek">
                <a asp-page="WiadomoscPubliczna">&larr; Wróć do listy</a>
            </div>
            <h2>@Model.Wybrana.wiaTemat</h2>
            <p class="text-muted">@Model.Wybrana.wiaData?.ToString("g")</p>
            <div class="border rounded p-3 mb-3 glos-tresc">
                @Html.Raw(Model.Wybrana.wiaTresc)
            </div>

            @if (Model.Zalaczniki.Count > 0)
            {
                <h5>Załączniki</h5>
                <ul class="list-unstyled">
                    @foreach (var zalacznik in Model.Zalaczniki)
                    {
                        <li class="mb-1">
                            <a asp-page-handler="Download" asp-route-wdoID="@zalacznik.wdoID">@zalacznik.wdoNazwa</a>
                        </li>
                    }
                </ul>
            }
        }
        else
        {
            <div class="glos-naglowek">
                <h2 class="m-0">Wiadomości</h2>
            </div>

            @if (Model.MozeZarzadzac)
            {
                <component type="typeof(indigoERP.Blazor.Pages.WiadomoscPubliczna.WiadomosciPanel)" render-mode="Server" />
            }

            @if (Model.Wiadomosci.Count > 0)
            {
                <div class="glos-grid">
                    @foreach (var wiadomosc in Model.Wiadomosci)
                    {
                        Model.PierwszePdf.TryGetValue(wiadomosc.wiaID, out var pdf);

                        <article class="glos-kafelek">
                            <a asp-page="WiadomoscPubliczna" asp-route-wiaID="@wiadomosc.wiaID" class="glos-miniatura">
                                @if (pdf != null)
                                {
                                    <img src="@Url.Page("WiadomoscPubliczna", "Miniatura", new { wdoID = pdf.wdoID })"
                                         alt="Pierwsza strona: @wiadomosc.wiaTemat" loading="lazy" />
                                }
                                else
                                {
                                    <span class="glos-miniatura-brak">Brak PDF</span>
                                }
                            </a>
                            <div class="glos-kafelek-tresc">
                                <small class="text-muted">@wiadomosc.wiaData?.ToString("d")</small>
                                <h5><a asp-page="WiadomoscPubliczna" asp-route-wiaID="@wiadomosc.wiaID">@wiadomosc.wiaTemat</a></h5>
                                <p>@WiadomoscPublicznaModel.SkrocOpis(wiadomosc.wiaTresc)</p>
                                <div class="glos-akcje">
                                    <a class="btn btn-sm btn-outline-secondary" asp-page="WiadomoscPubliczna" asp-route-wiaID="@wiadomosc.wiaID">Czytaj</a>
                                    @if (pdf != null)
                                    {
                                        <a class="btn btn-sm btn-primary" asp-page-handler="Download" asp-route-wdoID="@pdf.wdoID">Pobierz PDF</a>
                                    }
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        }
    </div>

    <footer class="footer text-muted mt-auto">
        <div class="container-fluid w-100">
            <div class="row">
                <div class="col-12 text-light">
                    <div class="d-inline-block">
                        Copyright&copy; <a href="@Url.Content("~/")" class="text-light" aria-label="Przejdź do indigoERP">Huta Częstochowa
                        <img src="~/images/logo/Logo16.png" /></a> 1993 - @DateTime.Now.Year All Rights Reserved
                    </div>
                    <div class="d-inline-block ms-5">
                        <img src="~/images/footer/ico_phone.png" width="20" /> <span class="ms-2">+48 34 323 8000</span>
                    </div>
                    <div class="d-inline-block ms-5">
                        <a href="mailto:itsupport@huta-czestochowa.pl">
                            <img src="~/images/footer/ico_email.png" width="20" /><span class="ms-2">itsupport@huta-czestochowa.pl</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </footer>
    @if (Model.MozeZarzadzac)
    {
        <script src="js/glos-hutnika.js"></script>
        <script src="_framework/blazor.server.js"></script>
    }
</body>
</html>
