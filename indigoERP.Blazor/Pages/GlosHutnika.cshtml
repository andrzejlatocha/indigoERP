@page "/gloshutnika"
@model indigoERP.Blazor.Pages.GlosHutnikaModel

@{
    Layout = null;
    var lata = Model.Lata.Count > 0 ? Model.Lata : new List<int> { Model.Rok };
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Głos Hutnika</title>
    <base href="~/" />
    <link href="~/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/fontawesome.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/css/wiadomosc-publiczna.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-dark bg-dark header-color header-navbar">
        <div class="container-fluid">
            <span class="navbar-brand">
                <img class="app-header-logo" src="~/images/logo_white.svg" />
                Głos Hutnika
            </span>
        </div>
    </nav>

    <div class="glos-page">
        <div class="glos-naglowek">
            <div>
                <h2 class="m-0">Głos Hutnika</h2>
                <p class="text-muted mb-0">Głos Hutnika Huty Częstochowa</p>
            </div>
            <form method="get" class="glos-rok">
                <label for="rok" class="me-2">Rok</label>
                <select id="rok" name="rok" class="form-select form-select-sm" onchange="this.form.submit()">
                    @foreach (var rok in lata)
                    {
                        <option value="@rok" selected="@(rok == Model.Rok)">@rok</option>
                    }
                </select>
            </form>
        </div>

        @if (Model.Numery.Count == 0)
        {
            <p>Brak numerów w roku @Model.Rok.</p>
        }
        else
        {
            <div class="glos-gh-siatka">
                @foreach (var numer in Model.Numery)
                {
                    <a class="glos-gh-kafelek" href="@Url.Page("WiadomoscPubliczna", "Download", new { wdoID = numer.Pdf.wdoID })"
                       title="Pobierz PDF: @numer.Data?.ToString("d")">
                        <img src="@Url.Page("WiadomoscPubliczna", "Miniatura", new { wdoID = numer.Pdf.wdoID })"
                             alt="Pierwsza strona numeru z @numer.Data?.ToString("d")" loading="lazy" />
                        <span>@numer.Data?.ToString("d")</span>
                    </a>
                }
            </div>
        }
    </div>
    <footer class="footer text-muted mt-auto">
        <div class="container-fluid w-100">
            <div class="row">
                <div class="col-12 text-light">
                    <div class="d-inline-block">
                        Copyright&copy; <a href="@Url.Content("~/")" class="text-light" aria-label="Przejdź do indigoERP">Huta Częstochowa
                        <img src="~/images/logo/Logo16.png" /></a> 1993 - @DateTime.Now.Year All Rights Reserved
                    </div>
                    <div class="d-inline-block ms-5">
                        <img src="~/images/footer/ico_phone.png" width="20" /> <span class="ms-2">+48 34 323 8000</span>
                    </div>
                    <div class="d-inline-block ms-5">
                        <a href="mailto:itsupport@huta-czestochowa.pl">
                            <img src="~/images/footer/ico_email.png" width="20" /><span class="ms-2">itsupport@huta-czestochowa.pl</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </footer>
</body>
</html>
