@page
@using indigoERP.WebUI.Pages
@using Microsoft.AspNetCore.Identity
@model PulpitModel

@{
    ViewData["Title"] = "Pulpit";
    Layout = "_Empty";
}

@section Styles { <link rel="stylesheet" href="~/css/card.css" /> }

<div class=card-container>
    <div class="box" style="--clr:#89ec56">
        <div class=content>
            <div class="icon">
                <i class="fa-solid fa-calendar-image">
                </i>
            </div>
            <div class="text">
                <p>
                    Karta urlopowa
                </p>
                <a asp-page="_Pulpit/Urlop">Wejdź</a>
            </div>
        </div>
    </div>
    <div class="box" style="--clr:#eb5ae5">
        <div class=content>
            <div class="icon">
                <i class="fa-solid fa-key">
                </i>
            </div>
            <div class="text">
                <p>
                    Uprawnienia
                </p>
                <a asp-page="_Pulpit/Uprawnienie">Wejdź</a>
            </div>
        </div>
    </div>
    <div class="box" style="--clr:#d0ff00">
        <div class=content>
            <div class="icon">
                <i class="fa-solid fa-notes-medical">
                </i>
            </div>
            <div class="text">
                <p>
                    Badania okresowe
                </p>
                <a asp-page="_Pulpit/Badanie">Wejdź</a>
            </div>
        </div>
    </div>
    <div class="box" style="--clr:#5b98eb">
        <div class=content>
            <div class="icon">
                <i class="fa-solid fa-bomb">
