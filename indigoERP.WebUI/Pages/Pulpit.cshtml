            </div>
        </div>
    </div>
    <div class="box" style="--clr:#e5d25a">
        <div class=content>
            <div class="icon">
                <i class="fa-solid fa-file-spreadsheet">
                </i>
            </div>
            <div class="text">
                <p>
                    Wniosek o zaliczkę
                </p>
                <a asp-page="_Pulpit/Zaliczka">Wejdź</a>
            </div>
        </div>
    </div>
    <div class="box" style="--clr:#4b5dff">
