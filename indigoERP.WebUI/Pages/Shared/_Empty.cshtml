<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>epicaHR - @ViewData["Title"]</title>
    <link href="~/Images/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    @RenderSection("Styles", false)
    @RenderSection("Scripts", false)

    <link href="~/css/devextreme/bootstrap.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/fontawesome.min.css" />    
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body>
    <nav class="navbar navbar-dark liberty-bg fixed-top navbar-expand-md">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">
                <img src="~/images/logo_white.png" />
            </a>
            <div id="navbar" class="collapse navbar-collapse">
                <partial name="_MenuPartial.cshtml" />
                <p class="nav navbar-text">@User.Identity?.Name</p>
            </div>
            <div class="text-white pe-3">
                <partial name="_LoginPartial.cshtml" />
            </div>
        </div>
    </nav>
    <div class="container-fluid">
        <main role="main" class="pb-3 pt-5 mt-5">
            @RenderBody()
        </main>
    </div>
</body>

</html>